# Copy this file to .env and configure the values in Coolify environment variables.
# Do not hardcode real secrets in docker-compose.yaml.

# Coolify routes its configured domain to the service's exposed port (8080).
PORT=8080

# Optional second authentication layer at the terminal itself.
WEB_USERNAME=
WEB_PASSWORD=

# SSH destination. Use the Tailscale IP or DNS name of the Codex VPS.
SSH_HOST=100.64.0.12
SSH_PORT=22
SSH_USER=codex

# Paste the complete private key as a Coolify secret/multiline variable.
SSH_PRIVATE_KEY=

# Generate with: ssh-keyscan -H 100.64.0.12
# Store the output as a Coolify secret/multiline variable.
SSH_KNOWN_HOSTS=
SSH_STRICT_HOST_KEY_CHECKING=yes

# Leave empty for the user's normal SSH shell. Set true only after installing
# tmux on the Codex VPS.
SSH_SESSION_PERSISTENT=false
SSH_REMOTE_COMMAND=
SSH_SESSION_NAME=agentdesk
